<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kxxy.fdtrans"
    android:versionCode="13"
    android:versionName="0.13">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- targetSdk 30+ 的包可见性过滤：不加这段，getLaunchIntentForPackage("org.fdroid.fdroid")
         恒返回 null，设置页就会误报"未安装 F-Droid"，广播也发不出去 -->
    <queries>
        <package android:name="org.fdroid.fdroid" />
    </queries>

    <application
        android:label="F-Droid 实时翻译"
        android:hasCode="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="F-Droid：界面英文实时机翻成中文（Compose 文本层 hook）" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <!-- 跨进程配置读取：F-Droid 进程 uid 不同，读不到模块私有 prefs，
             改由本 provider 提供（只读、无敏感数据） -->
        <provider
            android:name=".Flags"
            android:authorities="com.kxxy.fdtrans.flags"
            android:exported="true" />

        <activity
            android:name=".Settings"
            android:exported="true"
            android:label="F-Droid 实时翻译">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
